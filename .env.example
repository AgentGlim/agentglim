# AgentGlim API keys. Copy this file to .env in the same folder and fill in the keys you use.
# .env is git-ignored: never commit it. A key already set in your shell or service environment wins over .env.
# Claude and Codex usage readings need no key here: they come from those CLIs' own login files.

# Jev (typesafe.ai) decision model. Optional. Used to label new model names, give plans a priority
# and pick the model and effort for subagent jobs (harness/bin/jev-route.mjs). Without it those
# features fall back to name rules or the default pick. Sign up: https://typesafe.ai
JEV_API_KEY=

# ElevenLabs (voice, sound effects, music). Optional. Owner sessions only: plan runs never use it.
# Shows credits used/left on the dashboard's ElevenLabs card.
# The card needs the key's "User: read" permission. Sign up: https://elevenlabs.io
ELEVENLABS_API_KEY=

# New-release check. The dashboard and /skills show a small update pill when a newer public release exists.
# It sends no user data and no token; the server asks GitHub at most once every 12 hours.
# Set to 1 to turn the check off (or use "updateCheck": false in integrations.json).
AGENTGLIM_NO_UPDATE_CHECK=
